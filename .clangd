CompileFlags:
  # Xtensa GCC flags that clang doesn't recognize.
  Remove:
    - -mlongcalls
    - -fstrict-volatile-bitfields
    - -fno-tree-switch-conversion
    - -fno-jump-tables
    - -freorder-blocks
  # Parse as a 32-bit bare-metal ELF target using the ESP32 toolchain's
  # C/C++ headers instead of the host (macOS) ones.
  Add:
    - --target=armv7a-none-eabi
    - -nostdinc
    - -nostdinc++
    - -isystem/Users/joshuarodli/.platformio/packages/toolchain-xtensa-esp32/xtensa-esp32-elf/include/c++/8.4.0
    - -isystem/Users/joshuarodli/.platformio/packages/toolchain-xtensa-esp32/xtensa-esp32-elf/include/c++/8.4.0/xtensa-esp32-elf
    - -isystem/Users/joshuarodli/.platformio/packages/toolchain-xtensa-esp32/lib/gcc/xtensa-esp32-elf/8.4.0/include
    - -isystem/Users/joshuarodli/.platformio/packages/toolchain-xtensa-esp32/lib/gcc/xtensa-esp32-elf/8.4.0/include-fixed
    - -isystem/Users/joshuarodli/.platformio/packages/toolchain-xtensa-esp32/xtensa-esp32-elf/include
Diagnostics:
  UnusedIncludes: None
